{
  "name": "vexryzer-automation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test": "pnpm test:pure && pnpm test:unit && pnpm test:component",
    "test:pure": "node --test tests/pure/*.node.test.ts",
    "test:unit": "vitest run tests/unit",
    "test:component": "vitest run tests/component",
    "test:e2e": "playwright test tests/e2e",
    "test:a11y": "playwright test tests/e2e/accessibility.spec.ts",
    "test:visual": "playwright test tests/visual --project=chromium-desktop",
    "verify:foundation": "node scripts/validate-foundation.mjs ..",
    "verify": "pnpm verify:foundation && pnpm typecheck && pnpm test && pnpm build && pnpm test:e2e && pnpm test:visual"
  },
  "dependencies": {
    "@xstate/react": "6.1.0",
    "@xyflow/react": "12.11.6",
    "motion": "13.1.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "xstate": "5.32.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.1.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "29.1.1",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
